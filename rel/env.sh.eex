#!/bin/sh

# A release built from a public image carries a public cookie, and anyone who
# has the cookie and can reach the node can run code on it. So the node starts
# only with a cookie of its own; rpc and remote need the same RELEASE_COOKIE.
case $RELEASE_COMMAND in
  start* | daemon*)
    if [ -z "$RELEASE_COOKIE" ] && [ "${RELEASE_DISTRIBUTION:-sname}" != "none" ]; then
      echo "ERROR: RELEASE_COOKIE is not set. Set it to a long random secret." >&2
      exit 1
    fi
    ;;
esac
